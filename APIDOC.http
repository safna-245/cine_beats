#api call fro signup
###
POST http://127.0.0.1:8000/filim/signup/
Content-Type: application/json

{
    "username":"admin",
    "password":"password@123",
    "email":"admin@gmail.com"
}

#api call for token
###
POST  http://127.0.0.1:8000/filim/token/
Content-Type: application/json

{
    "username":"admin",
    "password":"password@123"
}
#token user1-Token 3ee901680bf0a0172bc50cc671c8ba01437cb5ba
#admin 8ea2c2bb4c1213127a8a4554e29d240c8d164aa0


#=====movie endpoints====

#api call for list all movies
###
GET  http://127.0.0.1:8000/filim/movie/
Accept: application/json
Authorization: Token 3ee901680bf0a0172bc50cc671c8ba01437cb5ba


#api call for create movie
###
POST http://127.0.0.1:8000/filim/movie/
Content-Type: application/json
Authorization: Token 3ee901680bf0a0172bc50cc671c8ba01437cb5ba

{
    "title": "3 Idiots",
    "run_time": 170,
    "rating": "8.4",
    "language": "hindi",
    "genre": "comedy",
    "released_year": 2009
}

#api call for retrieve specific movie
###
GET http://127.0.0.1:8000/filim/movie/1/
Accept: application/json
Authorization: Token 3ee901680bf0a0172bc50cc671c8ba01437cb5ba

